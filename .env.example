# ─────────────────────────────────────────────────
# VerifyAI — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────

# ── Server ──────────────────────────────────────
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# ── AI Providers ────────────────────────────────
# Leave blank to run in Demo Mode (no real API calls)

# Google Gemini API key
# Get yours at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Groq API key
# Get yours at: https://console.groq.com/keys
GROQ_API_KEY=

# Hugging Face API token
# Get yours at: https://huggingface.co/settings/tokens
HUGGINGFACE_API_KEY=

# Ollama (optional, local AI)
# Default: http://localhost:11434 — only set if running Ollama
OLLAMA_URL=

# ── n8n Workflow ─────────────────────────────────
# Set this to your n8n webhook URL to enable full workflow orchestration.
# Example: http://localhost:5678/webhook/verify
# Leave blank to use direct API mode or Demo Mode.
N8N_WEBHOOK_URL=

# ── Database ────────────────────────────────────
# MongoDB connection string
# Default: mongodb://localhost:27017/verifyai
# For MongoDB Atlas: mongodb+srv://<username>:<password>@cluster.mongodb.net/verifyai
MONGODB_URI=mongodb://localhost:27017/verifyai
# Alternative environment variable name (same as MONGODB_URI)
DATABASE_URL=
