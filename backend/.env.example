# ==============================================================================
# VerifyAI Backend — Environment Variables
# ==============================================================================
# Copy this file to .env and configure your keys.
# NEVER commit .env to version control!

# ── Server Configuration ──────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# ── AI Providers (Optional — Leave blank to run in Demo Mode) ─────────────────
# Google Gemini API: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Groq Cloud API: https://console.groq.com/keys
GROQ_API_KEY=

# Hugging Face Access Token: https://huggingface.co/settings/tokens
HUGGINGFACE_API_KEY=

# Ollama Local Instance (optional)
OLLAMA_URL=http://localhost:11434

# ── Automation & Workflow ─────────────────────────────────────────────────────
# n8n Webhook URL (optional — leave empty for built-in verification engine)
N8N_WEBHOOK_URL=

# ── Database ──────────────────────────────────────────────────────────────────
# MongoDB Connection URI
MONGODB_URI=mongodb://localhost:27017/verifyai
DATABASE_URL=
